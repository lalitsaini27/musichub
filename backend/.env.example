# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — set DB_ENGINE=mysql to use MySQL, otherwise SQLite is used
DB_ENGINE=sqlite
DB_NAME=musichub_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS / CSRF — frontend origin(s) allowed to call the API / log into Django admin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- PythonAnywhere production example (uncomment and edit when deploying) ---
